# Ruta base del sitio publicado. Copia este archivo a .env si la necesitas.
#
#   raiz de dominio (Netlify, Vercel, servidor propio)  -> VITE_BASE=/
#   GitHub Pages de proyecto                            -> VITE_BASE=/coipo_notebooklm/
#
# Tambien se puede pasar por entorno sin crear el archivo:
#   PowerShell : $env:VITE_BASE='/coipo_notebooklm/'; npm run build
#   bash       : VITE_BASE=/coipo_notebooklm/ npm run build
VITE_BASE=/
